              "path": ["api", "admin", "settings"]
            },
            "description": "Replaces the whole store settings object. All fields are required."
          },
          "response": []
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"old-password\",\n  \"newPassword\": \"new-password-min-8\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/settings/password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "settings", "password"]
            },
            "description": "Changes the logged-in admin password. newPassword must be at least 8 characters. Returns 400 if currentPassword is incorrect."
          },
          "response": []
        }
      ]
    }
  ]
}
