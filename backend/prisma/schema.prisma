// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Product {
  id              Int         @id @default(autoincrement())
  slug            String      @unique
  name            String
  brandName       String      @map("brand_name")
  category        String      @default("Herbal Supplement")
  currentPrice    Int         @map("current_price")
  regularPrice    Int         @map("regular_price")
  discountPercent Int         @default(0) @map("discount_percent")
  inStock         Boolean     @default(true) @map("in_stock")
  isActive        Boolean     @default(true) @map("is_active")
  stockQuantity   Int         @default(0) @map("stock_quantity")
  images          Json
  orderFormConfig Json?       @map("order_form_config")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  orders          OrderItem[]
  reviews         Review[]

  @@map("products")
}

model Order {
  id              Int         @id @default(autoincrement())
  orderNumber     String      @unique @map("order_number")
  customerName    String      @map("customer_name")
  customerPhone   String      @map("customer_phone")
  customerAddress String      @map("customer_address")
  notes           String?
  deliveryArea    String      @map("delivery_area")
  deliveryCharge  Int         @map("delivery_charge")
  subtotal        Int
  total           Int
  paymentMethod   String      @default("cod") @map("payment_method")
  paymentStatus   String      @default("unpaid") @map("payment_status")
  status          String      @default("pending")
  createdAt       DateTime    @default(now()) @map("created_at")
  items           OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  productId Int     @map("product_id")
  quantity  Int
  unitPrice Int     @map("unit_price")
  lineTotal Int     @map("line_total")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  name      String
  location  String?
  rating    Int
  comment   String   @db.Text
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  name            String    @default("Admin")
  mobile          String?
  roleId          Int       @map("role_id")
  shopId          Int?      @map("shop_id")
  status          String    @default("active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  role      Role       @relation(fields: [roleId], references: [id])
  shop      Shop?      @relation(fields: [shopId], references: [id])
  auditLogs AuditLog[]

  @@map("users")
}

// ==================================================================
// Settings — four singleton rows (one per section)
// Pattern: id is always 1. Upsert on `where: { id: 1 }`.
// Not enforced by DB constraint, but code always uses id=1.
// ==================================================================

model StoreSettings {
  id          Int     @id @default(1)
  name        String
  tagline     String
  description String  @db.Text
  logo        String?

  phone         String
  phone2        String? @map("phone_2")
  whatsapp      String
  whatsapp2     String? @map("whatsapp_2")
  email         String
  address       String  @db.Text
  googleMapsUrl String? @map("google_maps_url") @db.Text

  facebook  String?
  instagram String?
  youtube   String?
  tiktok    String?

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

model StorefrontSettings {
  id                  Int      @id @default(1)
  announcementEnabled Boolean  @default(false) @map("announcement_enabled")
  announcementText    String?  @map("announcement_text") @db.Text
  orderNote           String?  @map("order_note") @db.Text
  primaryColor        String   @default("#0D9488") @map("primary_color")
  backgroundColor     String   @default("#FAF8FF") @map("background_color")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("storefront_settings")
}

model OrderSettings {
  id                    Int     @id @default(1)
  duplicateBlockEnabled Boolean @default(true) @map("duplicate_block_enabled")
  duplicateBlockMinutes Int     @default(15) @map("duplicate_block_minutes")
  locationFieldsEnabled Boolean @default(true) @map("location_fields_enabled")
  deliveryInsideDhaka   Int     @default(70) @map("delivery_inside_dhaka")
  deliveryOutsideDhaka  Int     @default(120) @map("delivery_outside_dhaka")
  freeDeliveryAbove     Int     @default(2000) @map("free_delivery_above")

  // Beta flags — always false in UI, but stored so toggling is one-line change later
  mobileVerificationEnabled Boolean @default(false) @map("mobile_verification_enabled")
  smsConfirmationEnabled    Boolean @default(false) @map("sms_confirmation_enabled")
  vpnProtectionEnabled      Boolean @default(false) @map("vpn_protection_enabled")
  courierProtectionEnabled  Boolean @default(false) @map("courier_protection_enabled")
  courierMinSuccessRatio    Int     @default(65) @map("courier_min_success_ratio")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("order_settings")
}

model MarketingSettings {
  id                     Int       @id @default(1)
  facebookEnabled        Boolean   @default(false) @map("facebook_enabled")
  facebookPixelId        String?   @map("facebook_pixel_id")
  facebookTestEventCode  String?   @map("facebook_test_event_code")
  // Encrypted with AES-256-GCM before storage. Never returned to client.
  facebookTokenEncrypted String?   @map("facebook_token_encrypted") @db.Text
  facebookTokenUpdatedAt DateTime? @map("facebook_token_updated_at")

  tiktokEnabled        Boolean   @default(false) @map("tiktok_enabled")
  tiktokPixelId        String?   @map("tiktok_pixel_id")
  tiktokTokenEncrypted String?   @map("tiktok_token_encrypted") @db.Text
  tiktokTokenUpdatedAt DateTime? @map("tiktok_token_updated_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("marketing_settings")
}

// ==================================================================
// Banners — standalone table (public storefront carousel)
// ==================================================================

model Banner {
  id        Int      @id @default(autoincrement())
  imageUrl  String   @map("image_url") @db.Text
  altText   String?  @map("alt_text")
  linkUrl   String?  @map("link_url") @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, position])
  @@map("banners")
}

// ==================================================================
// Coupons — real entities
// ==================================================================

model Coupon {
  id               Int       @id @default(autoincrement())
  code             String    @unique
  discountType     String    @map("discount_type") // "percentage" | "amount"
  discountValue    Int       @map("discount_value")
  note             String?
  used             Int       @default(0)
  usageLimit       Int?      @map("usage_limit") // null = unlimited
  maxDiscountValue Int?      @map("max_discount_value")
  minPurchaseValue Int?      @map("min_purchase_value")
  expiresAt        DateTime? @map("expires_at")
  status           String    @default("active") // "active" | "paused" | "expired"
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([expiresAt])
  @@map("coupons")
}

// ==================================================================
// Pages — CMS entries + revision history
// ==================================================================

model Page {
  id            Int      @id @default(autoincrement())
  title         String
  slug          String   @unique
  contentHtml   String   @map("content_html") @db.LongText
  status        String   @default("draft") // "published" | "draft"
  language      String   @default("EN")
  lastEditedBy  String   @map("last_edited_by")
  revisionCount Int      @default(1) @map("revision_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  revisions PageRevision[]

  @@map("pages")
}

model PageRevision {
  id          Int      @id @default(autoincrement())
  pageId      Int      @map("page_id")
  title       String
  contentHtml String   @map("content_html") @db.LongText
  editedBy    String   @map("edited_by")
  editedAt    DateTime @default(now()) @map("edited_at")
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, editedAt])
  @@map("page_revisions")
}

// ==================================================================
// Courier settings — singleton (id=1)
// Zones are hardcoded in frontend (3 fixed tiers for Bangladesh).
// Only fee amounts + toggles are stored server-side.
// ==================================================================

model CourierSettings {
  id                Int      @id @default(1)
  enabled           Boolean  @default(true)
  flatFeeEnabled    Boolean  @default(true) @map("flat_fee_enabled")
  insideDhakaFee    Int      @default(60) @map("inside_dhaka_fee")
  subDhakaFee       Int      @default(100) @map("sub_dhaka_fee")
  outsideDhakaFee   Int      @default(130) @map("outside_dhaka_fee")
  freeDeliveryAbove Int      @default(2000) @map("free_delivery_above")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("courier_settings")
}

model Shop {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  status      String    @default("active")
  trialEndsAt DateTime? @map("trial_ends_at")
  expiryDate  DateTime? @map("expiry_date")
  mobile      String?
  address     String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  users     User[]
  auditLogs AuditLog[]

  @@map("shops")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  displayName String   @map("display_name")
  scope       String
  permissions Json     @default("{}")
  isSystem    Boolean  @default(false) @map("is_system")
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  shopId     Int?     @map("shop_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  user User  @relation(fields: [userId], references: [id])
  shop Shop? @relation(fields: [shopId], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@index([shopId])
  @@index([action])
  @@map("audit_logs")
}
